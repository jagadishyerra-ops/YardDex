rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can sign in and create or join a family. Families are created, joined and left only through
    // the `family` Cloud Function (which checks invite codes), so the app can never add people itself.
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isMember(fid) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/families/$(fid)).data.members;
    }

    // users/{uid}: familyIds = every family you're in (written only by the Cloud Function);
    // familyId = the one you're looking at. You may switch familyId, but only to a family already in your list.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['familyId'])
        && resource.data.familyIds is list
        && request.resource.data.familyId in resource.data.familyIds;
      allow create, delete: if false;
    }

    match /families/{fid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      // Members may rename the family and edit explorers & places; membership changes go through the function.
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'explorers', 'places'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.explorers is list && request.resource.data.explorers.size() <= 30
        && request.resource.data.places is list && request.resource.data.places.size() <= 30;
      allow create, delete: if false;

      match /finds/{doc} {
        allow read, delete: if isMember(fid);
        allow create, update: if isMember(fid)
          && request.resource.data.name is string
          && request.resource.data.createdAt is string
          && request.resource.size() < 40;
      }
    }

    match /invites/{code} { allow read, write: if false; }  // Cloud Function only
    match /usage/{doc}    { allow read, write: if false; }  // Cloud Function only
  }
}
